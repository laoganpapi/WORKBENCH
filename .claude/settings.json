{
  "extraKnownMarketplaces": {
    "fabled": {
      "source": {
        "source": "github",
        "repo": "laoganpapi/MASTER"
      }
    }
  },
  "enabledPlugins": {
    "fabled@fabled": true
  },
  "outputStyle": "fabled:fabled",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/plugins/marketplaces/fabled/fabled/scripts/refresh_install.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr:*)",
      "Bash(python3:*)"
    ]
  }
}
